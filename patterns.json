{
  "version": "3.1.0",
  "description": "Backward-compatible transformation patterns with enhanced template support",
  "patterns": [
    {
      "id": "console-log-to-console-error",
      "language": "typescript",
      "pattern": "console.log('Error:",
      "replacement": "console.error('Error:",
      "description": "Convert console.log for errors to console.error",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "fix-double-semicolons",
      "language": "typescript",
      "pattern": ";;",
      "replacement": ";",
      "description": "Remove double semicolons syntax errors",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "fix-malformed-object-literal",
      "language": "typescript",
      "pattern": "= {;",
      "replacement": "= {",
      "description": "Fix malformed object literal with semicolon",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "smart-var-to-const-let",
      "language": "typescript",
      "pattern": "var $NAME = $VALUE",
      "replacement": "const $NAME = $VALUE",
      "description": "Smart conversion of var to const/let based on usage analysis",
      "complexity": 3,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "strict-equality",
      "language": "typescript",
      "pattern": "$LEFT == $RIGHT",
      "replacement": "$LEFT === $RIGHT",
      "description": "Convert loose equality to strict equality",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "strict-inequality",
      "language": "typescript",
      "pattern": "$LEFT != $RIGHT",
      "replacement": "$LEFT !== $RIGHT",
      "description": "Convert loose inequality to strict inequality",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "array-includes-instead-of-indexof",
      "language": "typescript",
      "pattern": "$ARR.indexOf($ITEM) !== -1",
      "replacement": "$ARR.includes($ITEM)",
      "description": "Use Array.includes() instead of indexOf() !== -1",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "object-property-shorthand",
      "language": "typescript",
      "pattern": "{ $KEY: $KEY }",
      "replacement": "{ $KEY }",
      "description": "Use object property shorthand syntax",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "remove-unnecessary-returns",
      "language": "typescript",
      "pattern": "($PARAMS) => { return $EXPR; }",
      "replacement": "($PARAMS) => $EXPR",
      "description": "Remove unnecessary return statements from arrow functions",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "const-loop-variable-fix",
      "language": "typescript",
      "pattern": "for (const $VAR = $INIT; $COND; $UPDATE)",
      "replacement": "for (let $VAR = $INIT; $COND; $UPDATE)",
      "description": "Fix const loop variables that get reassigned",
      "complexity": 2,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "promise-to-async-await",
      "language": "typescript",
      "pattern": "$PROMISE.then(($RESULT) => { $BODY })",
      "replacement": "const $RESULT = await $PROMISE;\\n$BODY",
      "description": "Convert Promise.then() chains to async/await",
      "complexity": 4,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "template-literal-conversion",
      "language": "typescript",
      "pattern": "$STR1 + $VAR + $STR2",
      "replacement": "`${$STR1}${$VAR}${$STR2}`",
      "description": "Convert string concatenation to template literals",
      "complexity": 3,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "remove-console-log",
      "language": "typescript",
      "pattern": "console.log(",
      "replacement": "// console.log(",
      "description": "Comment out console.log statements for production",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "fix-trailing-comma",
      "language": "typescript",
      "pattern": ",}",
      "replacement": "}",
      "description": "Remove trailing commas before closing braces",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "fix-missing-semicolon",
      "language": "typescript",
      "pattern": "}\n",
      "replacement": "};\n",
      "description": "Add missing semicolons after statements",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "null-coalescing-operator",
      "language": "typescript",
      "pattern": "$VAR || $DEFAULT",
      "replacement": "$VAR ?? $DEFAULT",
      "description": "Use nullish coalescing operator for better null handling",
      "complexity": 2,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "optional-chaining",
      "language": "typescript",
      "pattern": "$OBJ && $OBJ.$PROP",
      "replacement": "$OBJ?.$PROP",
      "description": "Use optional chaining instead of guard checks",
      "complexity": 2,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "cpp-nullptr-conversion",
      "language": "cpp",
      "pattern": "NULL",
      "replacement": "nullptr",
      "description": "Convert NULL to nullptr for type safety",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-constexpr-const",
      "language": "cpp",
      "pattern": "static const ",
      "replacement": "static constexpr ",
      "description": "Use constexpr instead of const for compile-time constants",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-include-iostream",
      "language": "cpp",
      "pattern": "#include <iostream.h>",
      "replacement": "#include <iostream>",
      "description": "Use modern iostream header without .h extension",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-std-namespace",
      "language": "cpp",
      "pattern": "using namespace std;",
      "replacement": "// Avoid 'using namespace std;' - use specific declarations instead\n// using std::cout;\n// using std::endl;",
      "description": "Discourage global std namespace usage for better code hygiene",
      "complexity": 2,
      "riskLevel": "medium",
      "mode": "template"
    },
    {
      "id": "cpp-modern-cast",
      "language": "cpp",
      "pattern": "($TYPE)$EXPR",
      "replacement": "static_cast<$TYPE>($EXPR)",
      "description": "Use static_cast instead of C-style casts for type safety",
      "complexity": 3,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "cpp-double-include-fix",
      "language": "cpp",
      "pattern": "#include \"$HEADER\"\n#include \"$HEADER\"",
      "replacement": "#include \"$HEADER\"",
      "description": "Remove duplicate include statements",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "array-destructuring",
      "language": "typescript",
      "pattern": "const $VAR1 = $ARR[0]; const $VAR2 = $ARR[1];",
      "replacement": "const [$VAR1, $VAR2] = $ARR;",
      "description": "Use array destructuring for cleaner code",
      "complexity": 3,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "object-destructuring",
      "language": "typescript",
      "pattern": "const $VAR = $OBJ.$PROP;",
      "replacement": "const { $PROP: $VAR } = $OBJ;",
      "description": "Use object destructuring for property access",
      "complexity": 3,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "spread-operator-arrays",
      "language": "typescript",
      "pattern": "$ARR1.concat($ARR2)",
      "replacement": "[...$ARR1, ...$ARR2]",
      "description": "Use spread operator instead of concat for arrays",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "async-await-pattern",
      "language": "typescript",
      "pattern": "return $PROMISE.then($CALLBACK)",
      "replacement": "return await $PROMISE",
      "description": "Convert Promise.then to async/await pattern",
      "complexity": 4,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "type-assertion-improvement",
      "language": "typescript",
      "pattern": "<$TYPE>$EXPR",
      "replacement": "$EXPR as $TYPE",
      "description": "Use 'as' syntax instead of angle bracket type assertions",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "prefer-const-assertions",
      "language": "typescript",
      "pattern": "const $VAR = [$ITEMS] as const",
      "replacement": "const $VAR = [$ITEMS] as const",
      "description": "Use const assertions for immutable arrays",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "remove-unused-imports",
      "language": "typescript",
      "pattern": "import { $UNUSED } from '$MODULE';",
      "replacement": "",
      "description": "Remove unused import statements",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "prefer-readonly-arrays",
      "language": "typescript",
      "pattern": "$VAR: $TYPE[]",
      "replacement": "$VAR: readonly $TYPE[]",
      "description": "Use readonly arrays for immutable data",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "error-handling-improvement",
      "language": "typescript",
      "pattern": "catch (e)",
      "replacement": "catch (error: unknown)",
      "description": "Use proper error typing in catch blocks",
      "complexity": 2,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "cpp-add-comment-mark",
      "language": "cpp",
      "pattern": "namespace cudaq {",
      "replacement": "namespace cudaq { // CUDA-Q namespace",
      "description": "Add documentation comment to cudaq namespace",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "llm-complex-refactoring",
      "language": "typescript",
      "pattern": "complex function refactoring",
      "replacement": "AI-guided refactoring",
      "description": "Use LLM to refactor complex functions with multiple responsibilities",
      "complexity": 8,
      "riskLevel": "medium",
      "mode": "llm"
    },
    {
      "id": "llm-architectural-improvement",
      "language": "typescript",
      "pattern": "architectural improvement",
      "replacement": "AI-guided architecture",
      "description": "Use LLM to suggest and implement architectural improvements",
      "complexity": 9,
      "riskLevel": "high",
      "mode": "llm"
    },
    {
      "id": "llm-code-documentation",
      "language": "typescript",
      "pattern": "documentation generation",
      "replacement": "AI-generated documentation",
      "description": "Use LLM to generate comprehensive code documentation",
      "complexity": 6,
      "riskLevel": "low",
      "mode": "llm"
    },
    {
      "id": "llm-error-handling-improvement",
      "language": "typescript",
      "pattern": "error handling improvement",
      "replacement": "AI-improved error handling",
      "description": "Use LLM to improve error handling patterns and add proper error boundaries",
      "complexity": 7,
      "riskLevel": "medium",
      "mode": "llm"
    },
    {
      "id": "llm-performance-optimization",
      "language": "typescript",
      "pattern": "performance optimization",
      "replacement": "AI-optimized performance",
      "description": "Use LLM to identify and fix performance bottlenecks",
      "complexity": 8,
      "riskLevel": "medium",
      "mode": "llm"
    },
    {
      "id": "llm-type-inference-enhancement",
      "language": "typescript",
      "pattern": "type inference improvement",
      "replacement": "AI-enhanced type inference",
      "description": "Use LLM to infer proper TypeScript types and replace any types",
      "complexity": 7,
      "riskLevel": "medium",
      "mode": "llm"
    },
    {
      "id": "llm-semantic-refactoring",
      "language": "typescript",
      "pattern": "semantic refactoring",
      "replacement": "AI-guided semantic refactoring",
      "description": "Use LLM for intelligent code restructuring based on semantic understanding",
      "complexity": 9,
      "riskLevel": "medium",
      "mode": "llm"
    },
    {
      "id": "llm-algorithm-optimization",
      "language": "typescript",
      "pattern": "algorithm optimization",
      "replacement": "AI-optimized algorithms",
      "description": "Use LLM to optimize complex algorithms and data structures",
      "complexity": 8,
      "riskLevel": "medium",
      "mode": "llm"
    },
    {
      "id": "llm-design-pattern-application",
      "language": "typescript",
      "pattern": "design pattern application",
      "replacement": "AI-applied design patterns",
      "description": "Use LLM to identify and apply appropriate design patterns",
      "complexity": 7,
      "riskLevel": "medium",
      "mode": "llm"
    },
    {
      "id": "cuda-kernel-optimization",
      "language": "cuda",
      "pattern": "__global__ void $KERNEL_NAME($PARAMS) { $BODY }",
      "replacement": "__global__ void $KERNEL_NAME($PARAMS) { /* Optimized kernel */ $BODY }",
      "description": "Optimize CUDA kernel for better performance and memory coalescing",
      "complexity": 9,
      "riskLevel": "high",
      "mode": "llm"
    },
    {
      "id": "cuda-memory-coalescing",
      "language": "cuda",
      "pattern": "memory coalescing optimization",
      "replacement": "AI-optimized memory access patterns",
      "description": "Use LLM to optimize CUDA memory access patterns for coalescing",
      "complexity": 8,
      "riskLevel": "high",
      "mode": "llm"
    },
    {
      "id": "cuda-shared-memory-optimization",
      "language": "cuda",
      "pattern": "__shared__ $TYPE $VAR[$SIZE];",
      "replacement": "__shared__ $TYPE $VAR[$SIZE]; /* Optimized shared memory usage */",
      "description": "Optimize CUDA shared memory usage for better performance",
      "complexity": 8,
      "riskLevel": "medium",
      "mode": "llm"
    },
    {
      "id": "tensorrt-engine-optimization",
      "language": "cpp",
      "pattern": "TensorRT engine optimization",
      "replacement": "AI-optimized TensorRT engine",
      "description": "Use LLM to optimize TensorRT engine configuration and performance",
      "complexity": 9,
      "riskLevel": "high",
      "mode": "llm"
    },
    {
      "id": "tensorrt-precision-optimization",
      "language": "cpp",
      "pattern": "precision optimization",
      "replacement": "AI-optimized precision handling",
      "description": "Use LLM to optimize TensorRT precision settings (FP32/FP16/INT8)",
      "complexity": 8,
      "riskLevel": "medium",
      "mode": "llm"
    },
    {
      "id": "cuda-thread-block-optimization",
      "language": "cuda",
      "pattern": "dim3 $GRID($GRID_SIZE); dim3 $BLOCK($BLOCK_SIZE);",
      "replacement": "dim3 $GRID($GRID_SIZE); dim3 $BLOCK($BLOCK_SIZE); /* Optimized thread configuration */",
      "description": "Optimize CUDA thread block and grid dimensions for target hardware",
      "complexity": 7,
      "riskLevel": "medium",
      "mode": "llm"
    },
    {
      "id": "cpp-smart-pointer-modernization",
      "language": "cpp",
      "pattern": "$TYPE* $VAR = new $TYPE($ARGS);",
      "replacement": "auto $VAR = std::make_unique<$TYPE>($ARGS);",
      "description": "Convert raw pointers to smart pointers for better memory management",
      "complexity": 4,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "cpp-range-based-for-loop",
      "language": "cpp",
      "pattern": "for (int i = 0; i < $CONTAINER.size(); ++i) { $BODY }",
      "replacement": "for (const auto& item : $CONTAINER) { $BODY }",
      "description": "Convert traditional for loops to range-based for loops",
      "complexity": 3,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "cpp-auto-type-deduction",
      "language": "cpp",
      "pattern": "$TYPE $VAR = $EXPR;",
      "replacement": "auto $VAR = $EXPR;",
      "description": "Use auto for type deduction where appropriate",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "cuda-error-checking",
      "language": "cuda",
      "pattern": "cuda$FUNC($ARGS);",
      "replacement": "checkCudaErrors(cuda$FUNC($ARGS));",
      "description": "Add proper CUDA error checking to all CUDA API calls",
      "complexity": 3,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "tensorrt-logger-integration",
      "language": "cpp",
      "pattern": "nvinfer1::ILogger",
      "replacement": "nvinfer1::ILogger /* Enhanced logging for TensorRT */",
      "description": "Enhance TensorRT logger integration for better debugging",
      "complexity": 4,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cuda-stream-optimization",
      "language": "cuda",
      "pattern": "cudaStream_t $STREAM;",
      "replacement": "cudaStream_t $STREAM; /* Optimized CUDA stream usage */",
      "description": "Optimize CUDA stream usage for better concurrency",
      "complexity": 6,
      "riskLevel": "medium",
      "mode": "llm"
    },
    {
      "id": "tensorrt-dynamic-shapes",
      "language": "cpp",
      "pattern": "dynamic shape handling",
      "replacement": "AI-optimized dynamic shape handling",
      "description": "Use LLM to optimize TensorRT dynamic shape handling",
      "complexity": 8,
      "riskLevel": "high",
      "mode": "llm"
    },
    {
      "id": "cuda-occupancy-optimization",
      "language": "cuda",
      "pattern": "occupancy optimization",
      "replacement": "AI-optimized kernel occupancy",
      "description": "Use LLM to optimize CUDA kernel occupancy for target GPU",
      "complexity": 9,
      "riskLevel": "high",
      "mode": "llm"
    }
  ],
