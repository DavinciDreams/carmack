{
  "version": "2.0.0",
  "description": "Enhanced AST transformation patterns with semantic context awareness",
  "patterns": [
    {
      "id": "smart-var-to-const-let",
      "language": "typescript",
      "pattern": "var $NAME = $VALUE",
      "replacement": "const $NAME = $VALUE",
      "description": "Smart conversion of var to const/let based on usage analysis",
      "complexity": 3,
      "riskLevel": "medium"
    },
    {
      "id": "strict-equality",
      "language": "typescript",
      "pattern": "$LEFT == $RIGHT",
      "replacement": "$LEFT === $RIGHT",
      "description": "Convert loose equality to strict equality",
      "complexity": 1,
      "riskLevel": "low"
    },
    {
      "id": "console-log-to-console-error",
      "language": "typescript",
      "pattern": "console.log('Error:",
      "replacement": "console.error('Error:",
      "description": "Convert console.log for errors to console.error",
      "complexity": 1,
      "riskLevel": "low"
    },
    {
      "id": "promise-to-async-await",
      "language": "typescript",
      "pattern": "$PROMISE.then(($RESULT) => { $BODY })",
      "replacement": "const $RESULT = await $PROMISE;\n$BODY",
      "description": "Convert Promise.then() chains to async/await",
      "complexity": 4,
      "riskLevel": "medium"
    },
    {
      "id": "enhanced-object-destructuring",
      "language": "typescript",
      "pattern": "const $VAR1 = $OBJ.$PROP1;\nconst $VAR2 = $OBJ.$PROP2;",
      "replacement": "const { $PROP1: $VAR1, $PROP2: $VAR2 } = $OBJ;",
      "description": "Convert multiple property access to destructuring",
      "complexity": 3,
      "riskLevel": "low"
    },
    {
      "id": "remove-unnecessary-returns",
      "language": "typescript",
      "pattern": "($PARAMS) => { return $EXPR; }",
      "replacement": "($PARAMS) => $EXPR",
      "description": "Remove unnecessary return statements from arrow functions",
      "complexity": 2,
      "riskLevel": "low"
    }
  ],
  "categories": {
    "modernization": ["smart-var-to-const-let", "strict-equality", "promise-to-async-await"],
    "optimization": ["enhanced-object-destructuring", "remove-unnecessary-returns"],
    "logging": ["console-log-to-console-error"]
  },
  "metadata": {
    "created": "2025-01-06",
    "author": "Carmack Coder",
    "license": "MIT",
    "lastUpdated": "2025-01-06",
    "totalPatterns": 6
  }
}