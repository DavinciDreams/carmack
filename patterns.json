    ],
    "safety": [
      "array-includes-instead-of-indexof",
      "const-loop-variable-fix",
      "cpp-const-reference-param",
      "cpp-modern-cast"
    ],
    "logging": ["console-log-to-console-error"],
    "syntax-fixes": [
      "fix-double-semicolons",
      "fix-malformed-object-literal"
    ],
    "cpp-modernization": [
      "cpp-nullptr-conversion",
