{
  "version": "3.0.0",
  "description": "Robust transformation patterns with enhanced AST-grep support",
  "patterns": [
    {
      "id": "smart-var-to-const-let",
      "language": "typescript",
      "pattern": "var $NAME = $VALUE",
      "replacement": "const $NAME = $VALUE",
      "description": "Smart conversion of var to const/let based on usage analysis",
      "complexity": 3,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "strict-equality",
      "language": "typescript",
      "pattern": "$LEFT == $RIGHT",
      "replacement": "$LEFT === $RIGHT",
      "description": "Convert loose equality to strict equality",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "strict-inequality",
      "language": "typescript",
      "pattern": "$LEFT != $RIGHT",
      "replacement": "$LEFT !== $RIGHT",
      "description": "Convert loose inequality to strict inequality",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "console-log-to-console-error",
      "language": "typescript",
      "pattern": "console.log('Error:",
      "replacement": "console.error('Error:",
      "description": "Convert console.log for errors to console.error",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "promise-to-async-await",
      "language": "typescript",
      "pattern": "$PROMISE.then(($RESULT) => { $BODY })",
      "replacement": "const $RESULT = await $PROMISE;\\n$BODY",
      "description": "Convert Promise.then() chains to async/await",
      "complexity": 4,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "object-property-shorthand",
      "language": "typescript",
      "pattern": "{ $KEY: $KEY }",
      "replacement": "{ $KEY }",
      "description": "Use object property shorthand syntax",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "array-includes-instead-of-indexof",
      "language": "typescript",
      "pattern": "$ARR.indexOf($ITEM) !== -1",
      "replacement": "$ARR.includes($ITEM)",
      "description": "Use Array.includes() instead of indexOf() !== -1",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "const-loop-variable-fix",
      "language": "typescript",
      "pattern": "for (const $VAR = $INIT; $COND; $UPDATE)",
      "replacement": "for (let $VAR = $INIT; $COND; $UPDATE)",
      "description": "Fix const loop variables that get reassigned",
      "complexity": 2,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "template-literal-conversion",
      "language": "typescript",
      "pattern": "$STR1 + $VAR + $STR2",
      "replacement": "`${$STR1}${$VAR}${$STR2}`",
      "description": "Convert string concatenation to template literals",
      "complexity": 3,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "remove-unnecessary-returns",
      "language": "typescript",
      "pattern": "($PARAMS) => { return $EXPR; }",
      "replacement": "($PARAMS) => $EXPR",
      "description": "Remove unnecessary return statements from arrow functions",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "fix-double-semicolons",
      "language": "typescript",
      "pattern": ";;",
      "replacement": ";",
      "description": "Remove double semicolons syntax errors",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "fix-malformed-object-literal",
      "language": "typescript",
      "pattern": "= {;",
      "replacement": "= {",
      "description": "Fix malformed object literal with semicolon",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-nullptr-conversion",
      "language": "cpp",
      "pattern": "NULL",
      "replacement": "nullptr",
      "description": "Replace NULL with modern C++ nullptr",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-constexpr-const",
      "language": "cpp",
      "pattern": "static const ",
      "replacement": "static constexpr ",
      "description": "Use constexpr instead of const for compile-time constants",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-include-iostream",
      "language": "cpp",
      "pattern": "#include <iostream.h>",
      "replacement": "#include <iostream>",
      "description": "Replace deprecated iostream.h with modern iostream",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-std-namespace",
      "language": "cpp",
      "pattern": "using namespace std;",
      "replacement": "// using namespace std; // Consider using specific std:: prefixes instead",
      "description": "Discourage using namespace std in headers",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-modern-cast",
      "language": "cpp",
      "pattern": "\\($TYPE\\*\\)$EXPR",
      "replacement": "static_cast<$TYPE*>($EXPR)",
      "description": "Replace C-style casts with static_cast",
      "complexity": 2,
      "riskLevel": "medium",
      "mode": "template"
    },
    {
      "id": "cpp-double-include-fix",
      "language": "cpp",
      "pattern": "#include \"",
      "replacement": "#include \"",
      "description": "Ensure proper include formatting",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-add-comment-mark",
      "language": "cpp",
      "pattern": "namespace cudaq {",
      "replacement": "namespace cudaq { // CUDA-Q namespace",
      "description": "Add documentation comment to cudaq namespace",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    }
  ],
  "categories": {
    "modernization": [
      "smart-var-to-const-let",
      "strict-equality",
      "strict-inequality",
      "promise-to-async-await",
      "cpp-nullptr-conversion",
      "cpp-constexpr-const",
      "cpp-include-iostream",
      "cpp-std-namespace"
    ],
    "optimization": [
      "object-property-shorthand",
      "remove-unnecessary-returns",
      "template-literal-conversion",
      "cpp-smart-ptr-make",
      "cpp-unique-ptr-make",
      "cpp-emplace-back"
    ],
    "safety": ["array-includes-instead-of-indexof", "const-loop-variable-fix", "cpp-modern-cast"],
    "logging": ["console-log-to-console-error"],
    "syntax-fixes": ["fix-double-semicolons", "fix-malformed-object-literal"],
    "cpp-modernization": [
      "cpp-nullptr-conversion",
      "cpp-constexpr-const",
      "cpp-include-iostream",
      "cpp-std-namespace",
      "cpp-modern-cast",
      "cpp-double-include-fix"
    ]
  },
  "metadata": {
    "created": "2025-01-06",
    "author": "Carmack Coder",
    "license": "MIT",
    "lastUpdated": "2025-07-17",
    "totalPatterns": 18,
    "astGrepVersion": "0.38.6",
    "languages": ["typescript", "javascript", "cpp"],
    "features": [
      "Enhanced pattern matching",
      "Semantic analysis",
      "Robust transformations",
      "C++ modernization",
      "TypeScript optimization",
      "Cross-language support"
    ]
  }
}
