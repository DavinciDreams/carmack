{
  "version": "3.0.0",
  "description": "Robust transformation patterns with enhanced AST-grep support",
  "patterns": [
    {
      "id": "smart-var-to-const-let",
      "language": "typescript",
      "pattern": "var $NAME = $VALUE",
      "replacement": "const $NAME = $VALUE",
      "description": "Smart conversion of var to const/let based on usage analysis",
      "complexity": 3,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "strict-equality",
      "language": "typescript",
      "pattern": "$LEFT == $RIGHT",
      "replacement": "$LEFT === $RIGHT",
      "description": "Convert loose equality to strict equality",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "strict-inequality",
      "language": "typescript",
      "pattern": "$LEFT != $RIGHT",
      "replacement": "$LEFT !== $RIGHT",
      "description": "Convert loose inequality to strict inequality",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "console-log-to-console-error",
      "language": "typescript",
      "pattern": "console.log('Error:",
      "replacement": "console.error('Error:",
      "description": "Convert console.log for errors to console.error",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "promise-to-async-await",
      "language": "typescript",
      "pattern": "$PROMISE.then(($RESULT) => { $BODY })",
      "replacement": "const $RESULT = await $PROMISE;\\n$BODY",
      "description": "Convert Promise.then() chains to async/await",
      "complexity": 4,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "object-property-shorthand",
      "language": "typescript",
      "pattern": "{ $KEY: $KEY }",
      "replacement": "{ $KEY }",
      "description": "Use object property shorthand syntax",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "array-includes-instead-of-indexof",
      "language": "typescript",
      "pattern": "$ARR.indexOf($ITEM) !== -1",
      "replacement": "$ARR.includes($ITEM)",
      "description": "Use Array.includes() instead of indexOf() !== -1",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "const-loop-variable-fix",
      "language": "typescript",
      "pattern": "for (const $VAR = $INIT; $COND; $UPDATE)",
      "replacement": "for (let $VAR = $INIT; $COND; $UPDATE)",
      "description": "Fix const loop variables that get reassigned",
      "complexity": 2,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "template-literal-conversion",
      "language": "typescript",
      "pattern": "$STR1 + $VAR + $STR2",
      "replacement": "`${$STR1}${$VAR}${$STR2}`",
      "description": "Convert string concatenation to template literals",
      "complexity": 3,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "remove-unnecessary-returns",
      "language": "typescript",
      "pattern": "($PARAMS) => { return $EXPR; }",
      "replacement": "($PARAMS) => $EXPR",
      "description": "Remove unnecessary return statements from arrow functions",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "fix-double-semicolons",
      "language": "typescript",
      "pattern": ";;",
      "replacement": ";",
      "description": "Remove double semicolons syntax errors",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "fix-malformed-object-literal",
      "language": "typescript",
      "pattern": "= {;",
      "replacement": "= {",
      "description": "Fix malformed object literal with semicolon",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-nullptr-conversion",
      "language": "cpp",
      "pattern": "NULL",
      "replacement": "nullptr",
      "description": "Replace NULL with modern C++ nullptr",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-auto-type-deduction",
      "language": "cpp",
      "pattern": "$TYPE $VAR = $TYPE($ARGS)",
      "replacement": "auto $VAR = $TYPE($ARGS)",
      "description": "Use auto for type deduction when type is obvious",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "cpp-range-based-for",
      "language": "cpp",
      "pattern": "for (std::size_t $I = 0; $I < $CONTAINER.size(); ++$I)",
      "replacement": "for (const auto& item : $CONTAINER)",
      "description": "Convert traditional for loops to range-based for loops",
      "complexity": 3,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "cpp-smart-ptr-make",
      "language": "cpp",
      "pattern": "std::shared_ptr<$TYPE>(new $TYPE($ARGS))",
      "replacement": "std::make_shared<$TYPE>($ARGS)",
      "description": "Use make_shared instead of explicit new with shared_ptr",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "cpp-unique-ptr-make",
      "language": "cpp",
      "pattern": "std::unique_ptr<$TYPE>(new $TYPE($ARGS))",
      "replacement": "std::make_unique<$TYPE>($ARGS)",
      "description": "Use make_unique instead of explicit new with unique_ptr",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "cpp-override-keyword",
      "language": "cpp",
      "pattern": "virtual $RETURN $FUNC($PARAMS) {",
      "replacement": "$RETURN $FUNC($PARAMS) override {",
      "description": "Add override keyword to virtual function overrides",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "cpp-const-reference-param",
      "language": "cpp",
      "pattern": "void $FUNC($TYPE $PARAM)",
      "replacement": "void $FUNC(const $TYPE& $PARAM)",
      "description": "Pass large objects by const reference instead of value",
      "complexity": 3,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "cpp-emplace-back",
      "language": "cpp",
      "pattern": "$CONTAINER.push_back($TYPE($ARGS))",
      "replacement": "$CONTAINER.emplace_back($ARGS)",
      "description": "Use emplace_back instead of push_back for constructed objects",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "cpp-constexpr-const",
      "language": "cpp",
      "pattern": "static const $TYPE $VAR = $VALUE;",
      "replacement": "static constexpr $TYPE $VAR = $VALUE;",
      "description": "Use constexpr instead of const for compile-time constants",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-fix-include-guards",
      "language": "cpp",
      "pattern": "#ifndef $GUARD\n#define $GUARD",
      "replacement": "#pragma once",
      "description": "Replace include guards with pragma once",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "cpp-modern-cast",
      "language": "cpp",
      "pattern": "($TYPE*)$EXPR",
      "replacement": "static_cast<$TYPE*>($EXPR)",
      "description": "Replace C-style casts with static_cast",
      "complexity": 2,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "cpp-move-semantics",
      "language": "cpp",
      "pattern": "$VAR = $OTHER_VAR;",
      "replacement": "$VAR = std::move($OTHER_VAR);",
      "description": "Use move semantics for expensive-to-copy objects",
      "complexity": 4,
      "riskLevel": "high",
      "mode": "ast"
    }
  ],
  "categories": {
    "modernization": [
      "smart-var-to-const-let",
      "strict-equality",
      "strict-inequality",
      "promise-to-async-await",
