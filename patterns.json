{
  "version": "3.1.0",
  "description": "Backward-compatible transformation patterns with enhanced template support",
  "patterns": [
    {
      "id": "console-log-to-console-error",
      "language": "typescript",
      "pattern": "console.log('Error:",
      "replacement": "console.error('Error:",
      "description": "Convert console.log for errors to console.error",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "fix-double-semicolons",
      "language": "typescript",
      "pattern": ";;",
      "replacement": ";",
      "description": "Remove double semicolons syntax errors",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "fix-malformed-object-literal",
      "language": "typescript",
      "pattern": "= {;",
      "replacement": "= {",
      "description": "Fix malformed object literal with semicolon",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "smart-var-to-const-let",
      "language": "typescript",
      "pattern": "var $NAME = $VALUE",
      "replacement": "const $NAME = $VALUE",
      "description": "Smart conversion of var to const/let based on usage analysis",
      "complexity": 3,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "strict-equality",
      "language": "typescript",
      "pattern": "$LEFT == $RIGHT",
      "replacement": "$LEFT === $RIGHT",
      "description": "Convert loose equality to strict equality",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "strict-inequality",
      "language": "typescript",
      "pattern": "$LEFT != $RIGHT",
      "replacement": "$LEFT !== $RIGHT",
      "description": "Convert loose inequality to strict inequality",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "array-includes-instead-of-indexof",
      "language": "typescript",
      "pattern": "$ARR.indexOf($ITEM) !== -1",
      "replacement": "$ARR.includes($ITEM)",
      "description": "Use Array.includes() instead of indexOf() !== -1",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "object-property-shorthand",
      "language": "typescript",
      "pattern": "{ $KEY: $KEY }",
      "replacement": "{ $KEY }",
      "description": "Use object property shorthand syntax",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "remove-unnecessary-returns",
      "language": "typescript",
      "pattern": "($PARAMS) => { return $EXPR; }",
      "replacement": "($PARAMS) => $EXPR",
      "description": "Remove unnecessary return statements from arrow functions",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "const-loop-variable-fix",
      "language": "typescript",
      "pattern": "for (const $VAR = $INIT; $COND; $UPDATE)",
      "replacement": "for (let $VAR = $INIT; $COND; $UPDATE)",
      "description": "Fix const loop variables that get reassigned",
      "complexity": 2,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "promise-to-async-await",
      "language": "typescript",
      "pattern": "$PROMISE.then(($RESULT) => { $BODY })",
      "replacement": "const $RESULT = await $PROMISE;\\n$BODY",
      "description": "Convert Promise.then() chains to async/await",
      "complexity": 4,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "template-literal-conversion",
      "language": "typescript",
      "pattern": "$STR1 + $VAR + $STR2",
      "replacement": "`${$STR1}${$VAR}${$STR2}`",
      "description": "Convert string concatenation to template literals",
      "complexity": 3,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "remove-console-log",
      "language": "typescript",
      "pattern": "console.log(",
      "replacement": "// console.log(",
      "description": "Comment out console.log statements for production",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "fix-trailing-comma",
      "language": "typescript",
      "pattern": ",}",
      "replacement": "}",
      "description": "Remove trailing commas before closing braces",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "fix-missing-semicolon",
      "language": "typescript",
      "pattern": "}\n",
      "replacement": "};\n",
      "description": "Add missing semicolons after statements",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    },
    {
      "id": "null-coalescing-operator",
      "language": "typescript",
      "pattern": "$VAR || $DEFAULT",
      "replacement": "$VAR ?? $DEFAULT",
      "description": "Use nullish coalescing operator for better null handling",
      "complexity": 2,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "optional-chaining",
      "language": "typescript",
      "pattern": "$OBJ && $OBJ.$PROP",
      "replacement": "$OBJ?.$PROP",
      "description": "Use optional chaining instead of guard checks",
      "id": "cpp-constexpr-const",
      "language": "cpp",
      "pattern": "static const ",
      "replacement": "static constexpr ",
      "description": "Use constexpr instead of const for compile-time constants",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "array-destructuring",
      "language": "typescript",
      "pattern": "const $VAR1 = $ARR[0]; const $VAR2 = $ARR[1];",
      "replacement": "const [$VAR1, $VAR2] = $ARR;",
      "description": "Use array destructuring for cleaner code",
      "complexity": 3,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "object-destructuring",
      "language": "typescript",
      "pattern": "const $VAR = $OBJ.$PROP;",
      "replacement": "const { $PROP: $VAR } = $OBJ;",
      "description": "Use object destructuring for property access",
      "complexity": 3,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "spread-operator-arrays",
      "language": "typescript",
      "pattern": "$ARR1.concat($ARR2)",
      "replacement": "[...$ARR1, ...$ARR2]",
      "description": "Use spread operator instead of concat for arrays",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "async-await-pattern",
      "language": "typescript",
      "pattern": "return $PROMISE.then($CALLBACK)",
      "replacement": "return await $PROMISE",
      "description": "Convert Promise.then to async/await pattern",
      "complexity": 4,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "type-assertion-improvement",
      "language": "typescript",
      "pattern": "<$TYPE>$EXPR",
      "replacement": "$EXPR as $TYPE",
      "description": "Use 'as' syntax instead of angle bracket type assertions",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "prefer-const-assertions",
      "language": "typescript",
      "pattern": "const $VAR = [$ITEMS] as const",
      "replacement": "const $VAR = [$ITEMS] as const",
      "description": "Use const assertions for immutable arrays",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "remove-unused-imports",
      "language": "typescript",
      "pattern": "import { $UNUSED } from '$MODULE';",
      "replacement": "",
      "description": "Remove unused import statements",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "prefer-readonly-arrays",
      "language": "typescript",
      "pattern": "$VAR: $TYPE[]",
      "replacement": "$VAR: readonly $TYPE[]",
      "description": "Use readonly arrays for immutable data",
      "complexity": 2,
      "riskLevel": "low",
      "mode": "ast"
    },
    {
      "id": "error-handling-improvement",
      "language": "typescript",
      "pattern": "catch (e)",
      "replacement": "catch (error: unknown)",
      "description": "Use proper error typing in catch blocks",
      "complexity": 2,
      "riskLevel": "medium",
      "mode": "ast"
    },
    {
      "id": "cpp-add-comment-mark",
      "language": "cpp",
      "pattern": "namespace cudaq {",
      "replacement": "namespace cudaq { // CUDA-Q namespace",
      "description": "Add documentation comment to cudaq namespace",
      "complexity": 1,
      "riskLevel": "low",
      "mode": "template"
    }
  ],
