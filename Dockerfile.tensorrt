# TensorRT Oracle System Dockerfile
FROM oven/bun:1.1.29-alpine

# Install system dependencies
RUN apk add --no-cache \
    git \
    curl \
    postgresql-client \
    python3 \
    py3-pip \
    build-base \
    linux-headers

# Set working directory
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S tensorrt && \
    adduser -S tensorrt -u 1001 -G tensorrt

# Copy package files
COPY package.json bun.lockb* ./

# Install dependencies
RUN bun install --frozen-lockfile --production

# Copy source code
COPY . .

# Set up directories with proper permissions
RUN mkdir -p /workspace /repositories /app/logs && \
    chown -R tensorrt:tensorrt /workspace /repositories /app/logs /app

# Build TypeScript if needed
RUN bun run build 2>/dev/null || echo "No build script found, using source files directly"

# Switch to non-root user
USER tensorrt

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Default command (can be overridden by docker-compose)
CMD ["bun", "run", "src/ultra-minimal-server.ts"]

# Expose ports
EXPOSE 8080 8081