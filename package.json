{
  "name": "carmack-coder",
  "version": "0.1.0",
  "description": "A code editing agent architecture with provably correct outputs using Zod, Dafny, and AST-grep",
  "module": "index.ts",
  "type": "module",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "dev": "bun run index.ts",
    "build": "bun build index.ts --outdir ./dist",
    "format": "bunx biome format --write .",
    "lint": "bunx biome check --write .",
    "type-check": "bunx tsc --noEmit",
    "test": "bun run test/infrastructure/test-runner.ts",
    "test:all": "bun run test/infrastructure/test-runner.ts",
    "test:unit": "bun run test/infrastructure/test-runner.ts --category=unit",
    "test:integration": "bun run test/infrastructure/test-runner.ts --category=integration",
    "test:performance": "bun run test/infrastructure/test-runner.ts --category=performance",
    "test:e2e": "bun run test/infrastructure/test-runner.ts --category=e2e",
    "test:high": "bun run test/infrastructure/test-runner.ts --priority=high",
    "test:medium": "bun run test/infrastructure/test-runner.ts --priority=medium",
    "test:low": "bun run test/infrastructure/test-runner.ts --priority=low",
    "test:coverage": "bun run test/infrastructure/test-runner.ts --coverage",
    "test:verbose": "bun run test/infrastructure/test-runner.ts --verbose",
    "test:parallel": "bun run test/infrastructure/test-runner.ts --parallel",
    "test:bail": "bun run test/infrastructure/test-runner.ts --bail",
    "test:actors": "bun run test/infrastructure/test-runner.ts --pattern=actor",
    "test:validation": "bun run test/infrastructure/test-runner.ts --pattern=validation",
    "test:transformation": "bun run test/infrastructure/test-runner.ts --pattern=transformation",
    "test:pipeline": "bun run test/infrastructure/test-runner.ts --pattern=pipeline",
    "test:patterns": "bun run test/infrastructure/test-runner.ts --pattern=pattern",
    "test:git": "bun run test/infrastructure/test-runner.ts --pattern=git",
    "test:dafny": "bun run test/infrastructure/test-runner.ts --pattern=dafny",
    "test:telemetry": "bun run test/infrastructure/test-runner.ts --pattern=telemetry",
    "test:comprehensive": "bun run test/infrastructure/integration-suite.ts",
    "test:regression": "bun run test/infrastructure/integration-suite.ts --performance",
    "test:health": "bun run test/infrastructure/test-runner.ts --category=unit --priority=high",
    "test:smoke": "bun run test/infrastructure/test-runner.ts --category=integration --priority=high --bail",
    "test:ci": "bun run test/infrastructure/test-runner.ts --parallel --coverage --bail",
    "test:dev": "bun run test/infrastructure/test-runner.ts --category=unit --verbose",
    "test:debug": "bun run test/infrastructure/test-runner.ts --verbose --timeout=60000",
    "test:quick": "bun run test/infrastructure/test-runner.ts --priority=high --bail",
    "test:full": "bun run test/infrastructure/test-runner.ts --coverage --verbose",
    "docs:generate": "bun run docs-generate.ts",
    "docs:api": "bun run docs-generate.ts --format markdown --output-dir ./docs",
    "docs:html": "bun run docs-generate.ts --format html --output-dir ./docs",
    "docs:json": "bun run docs-generate.ts --format json --output-dir ./docs",
    "docs:full": "bun run docs-generate.ts --include-private --include-tests",
    "test:repo-manager": "bun run test-repository-manager.ts",
    "repo:process": "bun run test-repository-manager.ts",
    "llm:annotate": "bun run llm-annotate.ts",
    "llm:analyze": "bun run llm-annotate.ts --format markdown --verbose",
    "llm:project": "bun run llm-annotate.ts . --depth comprehensive",
    "llm:patterns": "bun run llm-annotate.ts --focus patterns --format markdown",
    "verify": "dafny verify src/**/*.dfy",
    "all-checks": "bun run format && bun run lint && bun run type-check && bun run test:high",
    "production": "bun run production.ts",
    "production:dry-run": "bun run production.ts --dry-run --verbose",
    "production:build": "bun build production.ts --outdir ./dist",
    "docker:build": "docker build -t carmack-coder:latest .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f carmack-coder",
    "k8s:deploy": "kubectl apply -f k8s/",
    "k8s:delete": "kubectl delete -f k8s/",
    "monitor": "open http://localhost:3000",
    "status": "echo '🚀 Carmack Coder Status Check' && bun run format && bun run lint && echo '✅ Linting: Clean' && bun run test:high && echo '✅ High Priority Tests: Passed' && echo '🎯 Overall: Production Ready!'"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@types/bun": "^1.2.18",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.38.6",
    "@types/node": "^24.0.10",
    "simple-git": "^3.28.0",
    "xstate": "^5.20.1",
    "zod": "^3.25.74"
  }
}
