{
  "name": "tensorrt-knowledge-graph",
  "version": "1.0.0",
  "description": "A comprehensive knowledge graph system for TensorRT-LLM with semantic indexing and oracle query processing",
  "main": "src/docs/demo.ts",
  "type": "module",
  "scripts": {
    "demo": "bun run src/docs/demo.ts",
    "dev": "bun --watch src/docs/demo.ts",
    "build": "tsc",
    "start": "bun run dist/docs/demo.js",
    "test": "bun run src/docs/test-system.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "setup-db": "bun run scripts/setup-database.ts",
    "verify": "bun run scripts/verify-deployment.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": ["tensorrt", "knowledge-graph", "semantic-search", "ai", "llm"],
  "author": "AI Carmack",
  "license": "MIT",
  "dependencies": {
    "pg": "^8.11.3",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
