# =============================================================================
# CARMACK CODER - COMPREHENSIVE ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# Copy this file to .env and configure the values for your specific use case.
# This file contains all environment variables used by the Carmack Coder system.
# 
# 📖 For detailed configuration guidance, see: docs/REPOSITORY-CONFIGURATION.md
# 
# IMPORTANT: This system works with TWO distinct repository concepts:
# 1. TARGET REPOSITORY - The external repository you want to analyze (e.g., NVIDIA TensorRT)
# 2. CARMACK SYSTEM REPOSITORY - The Carmack Coder system itself (this codebase)
# 
# =============================================================================

# =============================================================================
# 🎯 TARGET REPOSITORY CONFIGURATION
# =============================================================================
# This section configures the external repository you want to analyze and transform.
# This is the PRIMARY configuration that determines what code gets processed.

# Target Repository Settings (REQUIRED)
# The repository you want to analyze - change this for each project
REPOSITORY_URL=https://github.com/NVIDIA/TensorRT
BRANCH=main

# Alternative Target Repository Examples:
# REPOSITORY_URL=https://github.com/facebook/react          # JavaScript/TypeScript
# REPOSITORY_URL=https://github.com/django/django           # Python
# REPOSITORY_URL=https://github.com/rust-lang/rust          # Rust
# REPOSITORY_URL=https://github.com/golang/go               # Go
# REPOSITORY_URL=https://github.com/microsoft/vscode        # Multi-language

# Working Directory for Target Repository
# Where the target repository will be cloned and processed
CARMACK_WORKSPACE=./workspace
WORKSPACE_DIR=/tmp/carmack-workspace

# =============================================================================
# 🏠 CARMACK SYSTEM REPOSITORY CONFIGURATION
# =============================================================================
# This section configures the Carmack Coder system itself.
# ⚠️  DO NOT CHANGE THESE unless you're working with a fork of Carmack

# Carmack System Repository (DO NOT CHANGE for normal usage)
CARMACK_REPOSITORY_URL=https://github.com/DavinciDreams/carmack
CARMACK_REPOSITORY_OWNER=DavinciDreams
CARMACK_REPOSITORY_NAME=carmack
CARMACK_BRANCH=main

# Git Integration Settings
# Used for creating commits and pull requests
GIT_USER_NAME=Carmack Coder
GIT_USER_EMAIL=carmack@example.com
GIT_TOKEN=ghp_your_github_token_here

# =============================================================================
# 📁 FILE PROCESSING CONFIGURATION
# =============================================================================
# Configure which files to analyze based on your target repository's language(s)

# File Extensions - Configure based on target repository language
# NVIDIA TensorRT (C++/CUDA/Python):
ALLOWED_FILE_EXTENSIONS=.cpp,.cxx,.cc,.c++,.c,.h,.hpp,.cu,.cuh,.py

# Alternative configurations for different project types:
# JavaScript/TypeScript: .ts,.tsx,.js,.jsx,.mts,.cts
# Python only: .py,.pyx,.pyi
# Rust: .rs
# Go: .go
# Multi-language: .ts,.js,.py,.cpp,.c,.h,.hpp,.cu,.cuh

# File Processing Limits
# Adjust based on repository size and available resources
MAX_FILES_PER_BATCH=5
# ↑ Start with 5 for large repositories like TensorRT
# ↑ Can increase to 10-20 for smaller repositories
# ↑ Reduce to 3 if experiencing memory issues

MAX_COMPLEXITY_THRESHOLD=20
# ↑ Maximum cyclomatic complexity to process
# ↑ Higher values = more complex files processed
# ↑ Lower values = safer, faster processing

MAX_COMPLEXITY_INCREASE=0.2
# ↑ Maximum allowed complexity increase after transformation
# ↑ 0.2 = 20% increase allowed
# ↑ Lower values = stricter quality control

# Risk Level Filter
# Controls which transformations are applied based on safety assessment
RISK_LEVEL_FILTER=low
# ↑ Options: low, medium, high
# ↑ low = Only safest transformations (recommended for production code)
# ↑ medium = Balanced approach (good for most projects)
# ↑ high = All transformations (use with caution)

# =============================================================================
# 🔄 TRANSFORMATION CONFIGURATION
# =============================================================================
# Configure how code transformations are applied

# Transformation Strategy
# Order of transformation methods to try (fastest to slowest)
TRANSFORMATION_PREFERRED_ORDER=template,ast,llm
# ↑ template = Pattern-based replacements (fastest, safest)
# ↑ ast = Syntax tree transformations (medium speed, good accuracy)
# ↑ llm = AI-powered transformations (slowest, most flexible)

TRANSFORMATION_FALLBACK_ENABLED=true
# ↑ If template fails, try ast; if ast fails, try llm

TRANSFORMATION_PARALLEL_PROCESSING=false
# ↑ Process multiple files simultaneously
# ↑ Set to true for faster processing if you have sufficient resources

TRANSFORMATION_MAX_CONCURRENCY=3
# ↑ Maximum number of concurrent transformations
# ↑ Reduce if experiencing memory pressure

# =============================================================================
# 🤖 LLM CONFIGURATION
# =============================================================================
# Configure AI model settings for intelligent transformations

# LLM Provider Selection
LLM_PROVIDER=openai
# ↑ Options: openai, anthropic, openrouter, local, mock
# ↑ openai = GPT models (recommended for code)
# ↑ anthropic = Claude models (good for analysis)
# ↑ local = Self-hosted models (privacy-focused)
# ↑ mock = Testing mode (no real API calls)

LLM_MODEL=gpt-4
# ↑ Specific model to use
# ↑ gpt-4 = Most capable but slower/expensive
# ↑ gpt-3.5-turbo = Faster and cheaper
# ↑ claude-4-sonnet = Good balance of speed/quality

# API Keys (fill in your actual keys)
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# LLM Request Settings
LLM_TEMPERATURE=0.1
# ↑ Creativity vs consistency (0.0-1.0)
# ↑ Lower = more consistent code transformations

LLM_MAX_TOKENS=4000
# ↑ Maximum response length
# ↑ Higher = more detailed transformations but slower/expensive

LLM_TIMEOUT=30000
# ↑ Request timeout in milliseconds
# ↑ Increase for complex transformations

LLM_RETRIES=3
# ↑ Number of retry attempts on failure

# =============================================================================
# ⚡ RESOURCE LIMITS & PERFORMANCE
# =============================================================================
# Configure system resource usage and performance constraints

# Memory Limits
MAX_MEMORY_USAGE=2048
# ↑ Maximum memory usage in MB
# ↑ 2048MB = 2GB (recommended for large repositories like TensorRT)
# ↑ Reduce to 1024MB if running on constrained systems
# ↑ Increase to 4096MB for very large repositories

# CPU Usage
MAX_CPU_USAGE=80
# ↑ Maximum CPU utilization percentage
# ↑ 80% leaves headroom for other processes

# Timeout Settings
MAX_TRANSFORMATION_TIME=600000
# ↑ Maximum time per transformation in milliseconds
# ↑ 600000ms = 10 minutes (suitable for complex C++/CUDA files)
# ↑ Reduce to 300000ms (5 min) for simpler languages
# ↑ Increase to 1800000ms (30 min) for very complex files

DEFAULT_TIMEOUT=300000
# ↑ Default timeout for most operations (5 minutes)

ACTOR_TIMEOUT=60000
# ↑ Timeout for individual actor operations (1 minute)

PIPELINE_TIMEOUT=1800000
# ↑ Total pipeline timeout (30 minutes)
# ↑ Increase for very large repositories

# Concurrency Limits
MAX_CONCURRENT_TRANSFORMATIONS=3
# ↑ Number of files processed simultaneously
# ↑ Reduce to 2 for memory-constrained systems
# ↑ Increase to 5-8 for high-performance systems

MAX_CONCURRENT_VALIDATIONS=3
# ↑ Number of validation processes running simultaneously

# =============================================================================
# 📊 OUTPUT CONFIGURATION
# =============================================================================
# Configure where and how results are stored

# Output Directories
# Results will be stored in ./output/repositories/[repo-name]-[timestamp]/
OUTPUT_BASE_DIR=./output

# Pattern Storage
PATTERNS_FILE_PATH=./patterns.json
PATTERN_EFFECTIVENESS_FILE=./data/pattern-effectiveness.json

# Backup Configuration
ENABLE_BACKUPS=true
# ↑ Create backups before transformations (HIGHLY RECOMMENDED)

BACKUP_DIRECTORY=./.carmack-backups
BACKUP_RETENTION_DAYS=30
# ↑ Keep backups for 30 days

# Rollback Settings
ENABLE_AUTO_ROLLBACK=true
# ↑ Automatically rollback failed transformations

ROLLBACK_ON_TEST_FAILURE=true
ROLLBACK_ON_COMPLEXITY_INCREASE=true
# ↑ Rollback if transformations make code worse

# =============================================================================
# 🔍 QUALITY ASSURANCE SETTINGS
# =============================================================================
# Configure validation and quality checks

# Quality Gates
ENABLE_VALIDATION=true
# ↑ Validate transformations before applying (REQUIRED)

ENABLE_TESTING=true
# ↑ Run tests after transformations

ENABLE_COMPLEXITY_CHECK=true
# ↑ Check cyclomatic complexity changes

REQUIRE_TYPE_CHECK=false
# ↑ Set to false for C++/CUDA projects
# ↑ Set to true for TypeScript projects

ENABLE_FORMAT_CHECK=true
# ↑ Check code formatting consistency

MIN_TEST_COVERAGE=80
# ↑ Minimum test coverage percentage required

# Dafny Formal Verification (Advanced)
ENABLE_DAFNY_VERIFICATION=false
# ↑ Enable formal verification with Dafny
# ↑ Requires Dafny installation

DAFNY_PATH=/usr/local/bin/dafny
DAFNY_TIMEOUT=60000

# =============================================================================
# 🧠 PATTERN LEARNING & DISCOVERY
# =============================================================================
# Configure machine learning and pattern discovery features

# Pattern Discovery
ENABLE_PATTERN_DISCOVERY=true
# ↑ Learn new patterns from successful transformations

ENABLE_PATTERN_LEARNING=true
# ↑ Improve existing patterns based on effectiveness

PATTERN_CONFIDENCE_THRESHOLD=0.7
# ↑ Minimum confidence score for applying learned patterns

MAX_PATTERNS=100
# ↑ Maximum number of patterns to maintain

PATTERN_LEARNING_RATE=0.1
# ↑ How quickly patterns adapt to new data

# =============================================================================
# 📈 TELEMETRY & MONITORING
# =============================================================================
# Configure system monitoring and performance tracking

# Telemetry Configuration
CARMACK_TELEMETRY_ENABLED=true
# ↑ Collect performance and usage metrics

TELEMETRY_SAMPLE_RATE=0.1
# ↑ Sample 10% of operations for detailed telemetry

TELEMETRY_COLLECT_FILE_PATHS=false
# ↑ Set to false for privacy (recommended for proprietary code)

TELEMETRY_RETENTION_DAYS=90
# ↑ Keep telemetry data for 90 days

# Monitoring Endpoints
METRICS_ENDPOINT=http://localhost:9090/metrics
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# =============================================================================
# 🔐 SECURITY SETTINGS
# =============================================================================
# Configure security and access controls

# API Security
API_SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# File System Security
ALLOWED_WORKSPACE_PATHS=/tmp/carmack-workspace,./workspace
# ↑ Restrict file system access to these paths

RESTRICTED_FILE_PATTERNS=**/.env,**/secrets/**,**/*.key
# ↑ Never process these sensitive file patterns

# =============================================================================
# 🚀 APPLICATION SETTINGS
# =============================================================================
# Core application configuration

# Environment
NODE_ENV=development
# ↑ Options: development, staging, production

CARMACK_VERSION=1.0.0

# Logging
CARMACK_LOG_LEVEL=info
# ↑ Options: debug, info, warn, error
# ↑ Use 'debug' for troubleshooting

LOG_FORMAT=json
LOG_FILE_PATH=./logs/carmack.log
ENABLE_CONSOLE_LOGGING=true
ENABLE_FILE_LOGGING=true

# Development Settings
DEV_MODE=false
DEBUG_MODE=false
# ↑ Set to true for detailed debugging output

VERBOSE_LOGGING=false
# ↑ Set to true for maximum detail (can be overwhelming)

# =============================================================================
# 🧪 TESTING & DEVELOPMENT
# =============================================================================
# Settings for development and testing

# Mock Settings (for development/testing)
MOCK_LLM_RESPONSES=false
# ↑ Set to true to avoid API calls during testing

MOCK_GIT_OPERATIONS=false
# ↑ Set to true to avoid actual git operations during testing

MOCK_FILE_OPERATIONS=false
# ↑ Set to true for safe testing without file changes

# Test Configuration
TEST_TIMEOUT=60000
TEST_PARALLEL=true
TEST_COVERAGE_THRESHOLD=80

# =============================================================================
# 🔧 ADVANCED TOOL CONFIGURATION
# =============================================================================
# Configure external tools and binaries

# AST-grep Configuration
AST_GREP_BINARY_PATH=/usr/local/bin/ast-grep
AST_GREP_MAX_MATCHES=1000
AST_GREP_TIMEOUT=30000

# Biome Configuration (Code Formatting)
BIOME_CONFIG_PATH=./biome.json
BIOME_BINARY_PATH=./node_modules/.bin/biome

# TypeScript Configuration
TSC_CONFIG_PATH=./tsconfig.json
TSC_BINARY_PATH=./node_modules/.bin/tsc

# =============================================================================
# 🌐 EXTERNAL INTEGRATIONS
# =============================================================================
# Configure external service integrations

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_token_here
# ↑ Required for private repositories and creating PRs

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CHANNEL=#carmack-notifications

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=carmack@example.com

# =============================================================================
# 🏗️ DEPLOYMENT & CI/CD
# =============================================================================
# Configure deployment and continuous integration

# CI/CD Platform
CICD_PLATFORM=github
# ↑ Options: github, gitlab, azure, jenkins, custom

# Webhook Configuration
CICD_WEBHOOK_URL=https://api.github.com/repos/owner/repo/hooks
CICD_SECRET_TOKEN=your-webhook-secret-token

# Trigger Settings
TRIGGER_ON_PUSH=false
TRIGGER_ON_PR=true
AUTO_MERGE=false
# ↑ Set to true for automatic merging (use with caution)

# Container Configuration
CONTAINER_NAME=carmack-production
DOCKER_REGISTRY=ghcr.io/davincidreams/carmack
DOCKER_TAG=latest

# =============================================================================
# 🎛️ FEATURE FLAGS
# =============================================================================
# Enable/disable experimental features

FEATURE_EXPERIMENTAL_PATTERNS=false
# ↑ Enable experimental pattern discovery algorithms

FEATURE_ADVANCED_ANALYTICS=false
# ↑ Enable advanced code analytics and metrics

FEATURE_DISTRIBUTED_PROCESSING=false
# ↑ Enable distributed processing across multiple machines

FEATURE_REAL_TIME_COLLABORATION=false
# ↑ Enable real-time collaboration features

# =============================================================================
# 📋 CONFIGURATION EXAMPLES FOR DIFFERENT PROJECT TYPES
# =============================================================================

# Example 1: NVIDIA TensorRT (C++/CUDA) - Current Configuration
# REPOSITORY_URL=https://github.com/NVIDIA/TensorRT
# ALLOWED_FILE_EXTENSIONS=.cpp,.cxx,.cc,.c++,.c,.h,.hpp,.cu,.cuh,.py
# MAX_FILES_PER_BATCH=5
# RISK_LEVEL_FILTER=low
# MAX_TRANSFORMATION_TIME=600000

# Example 2: React (JavaScript/TypeScript)
# REPOSITORY_URL=https://github.com/facebook/react
# ALLOWED_FILE_EXTENSIONS=.ts,.tsx,.js,.jsx,.mts,.cts
# MAX_FILES_PER_BATCH=15
# RISK_LEVEL_FILTER=medium
# REQUIRE_TYPE_CHECK=true

# Example 3: Django (Python)
# REPOSITORY_URL=https://github.com/django/django
# ALLOWED_FILE_EXTENSIONS=.py,.pyx,.pyi
# MAX_FILES_PER_BATCH=20
# RISK_LEVEL_FILTER=medium
# REQUIRE_TYPE_CHECK=false

# Example 4: Rust Project
# REPOSITORY_URL=https://github.com/rust-lang/rust
# ALLOWED_FILE_EXTENSIONS=.rs
# MAX_FILES_PER_BATCH=10
# RISK_LEVEL_FILTER=low
# TRANSFORMATION_PREFERRED_ORDER=template,ast

# Example 5: Multi-language Project (VS Code)
# REPOSITORY_URL=https://github.com/microsoft/vscode
# ALLOWED_FILE_EXTENSIONS=.ts,.js,.py,.cpp,.c,.h
# MAX_FILES_PER_BATCH=8
# RISK_LEVEL_FILTER=low
# MAX_MEMORY_USAGE=4096

# =============================================================================
# 📚 QUICK REFERENCE
# =============================================================================
# 
# Key Variables to Change for Different Projects:
# 1. REPOSITORY_URL - The repository you want to analyze
# 2. ALLOWED_FILE_EXTENSIONS - File types for your project's language
# 3. MAX_FILES_PER_BATCH - Adjust based on repository size
# 4. RISK_LEVEL_FILTER - Safety level for transformations
# 5. MAX_TRANSFORMATION_TIME - Timeout based on code complexity
# 
# For detailed configuration guidance and troubleshooting:
# 📖 See: docs/REPOSITORY-CONFIGURATION.md
# 
# Repository Size Guidelines:
# • Small (<1K files): MAX_FILES_PER_BATCH=50, RISK_LEVEL_FILTER=medium
# • Medium (1K-10K files): MAX_FILES_PER_BATCH=20, RISK_LEVEL_FILTER=medium  
# • Large (10K-50K files): MAX_FILES_PER_BATCH=10, RISK_LEVEL_FILTER=low
# • Enterprise (>50K files): MAX_FILES_PER_BATCH=5, RISK_LEVEL_FILTER=low
# 
# =============================================================================