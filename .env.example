# =============================================================================
# Carmack Coder - Environment Configuration Example
# =============================================================================
# Copy this file to .env and configure the values for your environment
# This file contains all environment variables used by the Carmack Coder system

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# Application Environment
NODE_ENV=development
# Options: development, staging, production

# Application Version
CARMACK_VERSION=1.0.0

# =============================================================================
# REPOSITORY CONFIGURATION
# =============================================================================

# Primary repository settings (used by carmack.config.ts and production.config.ts)
CARMACK_REPOSITORY_URL=https://github.com/DavinciDreams/carmack
REPOSITORY_URL=https://github.com/DavinciDreams/vscrabbleproject
CARMACK_REPOSITORY_OWNER=DavinciDreams
CARMACK_REPOSITORY_NAME=carmack
CARMACK_BRANCH=main
BRANCH=main

# Working directory for transformations
CARMACK_WORKSPACE=./workspace
WORKSPACE_DIR=/tmp/carmack-workspace

# Git integration settings
GIT_USER_NAME=Carmack Coder
GIT_USER_EMAIL=carmack@example.com
GIT_TOKEN=ghp_your_github_token_here

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================

# LLM Provider Selection
# Options: openai, anthropic, local, mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=your-org-id

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Local LLM Configuration
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=codellama:7b

# LLM Request Settings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=30000
LLM_RETRIES=3

# =============================================================================
# TRANSFORMATION PIPELINE SETTINGS
# =============================================================================

# Transformation Strategy
TRANSFORMATION_PREFERRED_ORDER=template,ast,llm
TRANSFORMATION_FALLBACK_ENABLED=true
TRANSFORMATION_PARALLEL_PROCESSING=false
TRANSFORMATION_MAX_CONCURRENCY=3

# File Processing Limits
MAX_FILES_PER_BATCH=10
MAX_COMPLEXITY_THRESHOLD=15
MAX_COMPLEXITY_INCREASE=0.2

# Allowed file extensions (comma-separated)
ALLOWED_FILE_EXTENSIONS=.ts,.tsx,.js,.jsx,.mts,.cts

# Risk level filter
# Options: low, medium, high
RISK_LEVEL_FILTER=medium

# =============================================================================
# QUALITY ASSURANCE SETTINGS
# =============================================================================

# Quality Gates
ENABLE_VALIDATION=true
ENABLE_TESTING=true
ENABLE_COMPLEXITY_CHECK=true
REQUIRE_TYPE_CHECK=true
ENABLE_FORMAT_CHECK=true
MIN_TEST_COVERAGE=80

# Dafny Formal Verification
ENABLE_DAFNY_VERIFICATION=true
DAFNY_PATH=/usr/local/bin/dafny
DAFNY_TIMEOUT=60000

# =============================================================================
# PATTERN LEARNING & DISCOVERY
# =============================================================================

# Pattern Discovery
ENABLE_PATTERN_DISCOVERY=true
ENABLE_PATTERN_LEARNING=true
PATTERN_CONFIDENCE_THRESHOLD=0.7
MAX_PATTERNS=100
PATTERN_LEARNING_RATE=0.1

# Pattern Storage
PATTERNS_FILE_PATH=./patterns.json
PATTERN_EFFECTIVENESS_FILE=./data/pattern-effectiveness.json

# =============================================================================
# TELEMETRY & MONITORING
# =============================================================================

# Telemetry Configuration
CARMACK_TELEMETRY_ENABLED=true
TELEMETRY_SAMPLE_RATE=0.1
TELEMETRY_BATCH_SIZE=100
TELEMETRY_FLUSH_INTERVAL=5000
TELEMETRY_MAX_BUFFER_SIZE=1000

# Privacy Settings
TELEMETRY_COLLECT_USER_IDS=false
TELEMETRY_COLLECT_FILE_PATHS=true
TELEMETRY_RETENTION_DAYS=90

# Metrics Endpoints
METRICS_ENDPOINT=http://localhost:9090/metrics
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# Alerting
ALERTING_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
ALERT_EMAIL=alerts@example.com

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level
# Options: debug, info, warn, error
CARMACK_LOG_LEVEL=info
LOG_LEVEL=info

# Log Output
LOG_FORMAT=json
LOG_FILE_PATH=./logs/carmack.log
ENABLE_CONSOLE_LOGGING=true
ENABLE_FILE_LOGGING=true

# =============================================================================
# PERFORMANCE & RESOURCE LIMITS
# =============================================================================

# Performance Thresholds
MAX_TRANSFORMATION_TIME=300000
MAX_MEMORY_USAGE=1024
MAX_CPU_USAGE=80

# Timeout Settings
DEFAULT_TIMEOUT=300000
ACTOR_TIMEOUT=30000
PIPELINE_TIMEOUT=600000

# Concurrency Limits
MAX_CONCURRENT_TRANSFORMATIONS=5
MAX_CONCURRENT_VALIDATIONS=3

# =============================================================================
# BACKUP & ROLLBACK SETTINGS
# =============================================================================

# Backup Configuration
ENABLE_BACKUPS=true
BACKUP_DIRECTORY=./.carmack-backups
BACKUP_RETENTION_DAYS=30

# Rollback Settings
ENABLE_AUTO_ROLLBACK=true
ROLLBACK_ON_TEST_FAILURE=true
ROLLBACK_ON_COMPLEXITY_INCREASE=true
MAX_ROLLBACK_ATTEMPTS=3
ROLLBACK_TIMEOUT=60000

# =============================================================================
# CI/CD INTEGRATION
# =============================================================================

# CI/CD Platform
# Options: github, gitlab, azure, jenkins, custom
CICD_PLATFORM=github

# Webhook Configuration
CICD_WEBHOOK_URL=https://api.github.com/repos/owner/repo/hooks
CICD_SECRET_TOKEN=your-webhook-secret-token

# Trigger Settings
TRIGGER_ON_PUSH=false
TRIGGER_ON_PR=true
AUTO_MERGE=false

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# API Security
API_SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# File System Security
ALLOWED_WORKSPACE_PATHS=/tmp/carmack-workspace,./workspace
RESTRICTED_FILE_PATTERNS=**/.env,**/secrets/**,**/*.key

# =============================================================================
# DATABASE CONFIGURATION (if applicable)
# =============================================================================

# Database URL (for pattern storage, telemetry, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/carmack
REDIS_URL=redis://localhost:6379

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30000

# =============================================================================
# DOCKER & DEPLOYMENT SETTINGS
# =============================================================================

# Container Configuration
CONTAINER_NAME=carmack-production
DOCKER_REGISTRY=ghcr.io/davincidreams/carmack
DOCKER_TAG=latest

# Health Check Settings
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development Mode Settings
DEV_MODE=false
HOT_RELOAD=true
DEBUG_MODE=false
VERBOSE_LOGGING=false

# Test Configuration
TEST_TIMEOUT=60000
TEST_PARALLEL=true
TEST_COVERAGE_THRESHOLD=80

# Mock Settings (for development/testing)
MOCK_LLM_RESPONSES=false
MOCK_GIT_OPERATIONS=false
MOCK_FILE_OPERATIONS=false

# =============================================================================
# EXTERNAL SERVICE INTEGRATIONS
# =============================================================================

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=./github-app-private-key.pem

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CHANNEL=#carmack-notifications

# Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=carmack@example.com

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# AST-grep Configuration
AST_GREP_BINARY_PATH=/usr/local/bin/ast-grep
AST_GREP_MAX_MATCHES=1000
AST_GREP_TIMEOUT=30000

# Biome Configuration
BIOME_CONFIG_PATH=./biome.json
BIOME_BINARY_PATH=./node_modules/.bin/biome

# TypeScript Configuration
TSC_CONFIG_PATH=./tsconfig.json
TSC_BINARY_PATH=./node_modules/.bin/tsc

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature toggles for experimental features
FEATURE_EXPERIMENTAL_PATTERNS=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_DISTRIBUTED_PROCESSING=false
FEATURE_REAL_TIME_COLLABORATION=false

# =============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =============================================================================

# Production-specific settings
PRODUCTION_MODE=false
PRODUCTION_REGISTRY_URL=ghcr.io/davincidreams/carmack
PRODUCTION_DEPLOYMENT_ENV=dev

# Staging-specific settings
STAGING_DATABASE_URL=postgresql://staging-user:password@staging-db:5432/carmack
STAGING_LLM_PROVIDER=mock

# Development-specific settings
DEV_DATABASE_URL=postgresql://dev-user:password@localhost:5432/carmack_dev
DEV_WORKSPACE=./dev-workspace